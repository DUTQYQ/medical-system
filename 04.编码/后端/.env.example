# ============================================
# 环境变量模板
# 用法：cp .env.example .env 然后填入真实值
# 警告：.env 已在 .gitignore 中，绝不会被提交
#       任何真实 Key 都不得写入本文件或任何代码文件
# ============================================

# ---------- 大模型 API Key（三选一）----------
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# 当前启用的模型：deepseek / qwen / glm
LLM_PROVIDER=deepseek
# 可选：仅后端读取的兼容 API 地址和模型名；留空使用提供方默认值
LLM_BASE_URL=
LLM_MODEL=

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=kangyang

# 可选：独立演示/测试库完整 URL；留空时使用上面的 MySQL 参数
# 真实 MySQL 密码仅写本机 .env，勿发到聊天或提交 Git
DATABASE_URL=

# ---------- JWT ----------
SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 向量库（RAG）----------
VECTOR_STORE=chroma
EMBEDDING_MODEL=bge-small-zh

# 离线默认使用明确标注的哈希文本向量，不会下载模型
EMBEDDING_PROVIDER=hash
# 可选：只从已存在的完整 SentenceTransformer 模型目录加载，不自动下载
EMBEDDING_MODEL_PATH=
# 当前实现为哈希词形向量 + Chroma，不宣称已加载 bge 语义模型
RAG_TOP_K=3
VECTOR_STORE_PATH=config.local.chroma

# ---------- AI 调用限流 ----------
MAX_INPUT_CHARS=500
DAILY_CALL_LIMIT=200

# 单进程服务可显式恢复重启遗留的超时摘要；多 worker 不启用此恢复
SUMMARY_RECOVERY_ENABLED=false
