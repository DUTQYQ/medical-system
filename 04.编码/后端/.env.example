# ============================================
# 环境变量模板
# 用法：cp .env.example .env 然后填入真实值
# 警告：.env 已在 .gitignore 中，绝不会被提交
#       任何真实 Key 都不得写入本文件或任何代码文件
# ============================================

# ---------- 大模型 API Key（三选一）----------
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# 当前启用的模型：deepseek / qwen / glm
LLM_PROVIDER=deepseek

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kangyang

# ---------- JWT ----------
SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# ---------- 向量库（RAG）----------
VECTOR_STORE=chroma
EMBEDDING_MODEL=bge-small-zh

# ---------- AI 调用限流 ----------
MAX_INPUT_CHARS=500
DAILY_CALL_LIMIT=200
