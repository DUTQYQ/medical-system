digraph G {
  graph [fontname="Microsoft YaHei", bgcolor="white", rankdir=TB,
         nodesep=0.35, ranksep=0.5, dpi=200, pad=0.3, splines=spline, compound=true, size="9,6"];
  node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=15,
         penwidth=1.5, margin="0.20,0.12", fillcolor="#eff6ff", color="#3b82f6"];
  edge  [fontname="Microsoft YaHei", fontsize=12, color="#94a3b8", fontcolor="#475569",
         penwidth=1.1, arrowsize=0.7];
  node [shape=plaintext, fillcolor="white", color="white", style=""];
  subgraph cluster_cls {
    label="M3 健康指标　类图（HEALTH）"; labeljust="l"; fontname="Microsoft YaHei";
    fontsize=16; fontcolor="#0f172a"; style="rounded"; color="#cbd5e1"; penwidth=1.4; margin=14;
    HealthRouter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#eff6ff" COLOR="#3b82f6"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>HealthRouter</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">接口层：录入 / 列表 / 删除 / 趋势</FONT></TD></TR></TABLE>>];
    HealthRecordService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#eff6ff" COLOR="#3b82f6"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>HealthRecordService</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">应用层：录入校验、趋势聚合</FONT></TD></TR></TABLE>>];
    ThresholdChecker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#fef3c7" COLOR="#d97706"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>ThresholdChecker</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">按 sys_config 阈值判定异常与风险等级</FONT></TD></TR></TABLE>>];
    HealthRecordRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f8fafc" COLOR="#64748b"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>HealthRecordRepository</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">数据层：指标写入与趋势查询</FONT></TD></TR></TABLE>>];
    HealthRecordModel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f8fafc" COLOR="#64748b"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>HealthRecordModel</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">实体：health_record 表映射（val1 / val2）</FONT></TD></TR></TABLE>>];
  }
  HealthRouter -> HealthRecordService [label="调用", arrowhead=vee, color="#64748b"];
  HealthRecordService -> ThresholdChecker [label="判级", arrowhead=vee, color="#64748b"];
  HealthRecordService -> HealthRecordRepository [label="读写", arrowhead=vee, color="#64748b"];
  HealthRecordRepository -> HealthRecordModel [label="映射", arrowhead=vee, color="#64748b"];
}
