digraph G {
  graph [fontname="Microsoft YaHei", bgcolor="white", rankdir=TB,
         nodesep=0.35, ranksep=0.5, dpi=200, pad=0.3, splines=spline, compound=true, size="9,4.6"];
  node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=15,
         penwidth=1.5, margin="0.20,0.12", fillcolor="#eff6ff", color="#3b82f6"];
  edge  [fontname="Microsoft YaHei", fontsize=12, color="#94a3b8", fontcolor="#475569",
         penwidth=1.1, arrowsize=0.7];
  subgraph cluster_main {
    label="M5 主动预警　模块结构（ALERT）\n实线箭头＝调用与读写；虚线箭头＝依赖与上游触发"; labeljust="l"; fontname="Microsoft YaHei";
    fontsize=16; fontcolor="#0f172a"; style="rounded"; color="#cbd5e1"; penwidth=1.4; margin=14;
    s1 [label="AlertRouter\napp/api/v1/alerts.py", fillcolor="#dbeafe", color="#3b82f6"];
    s2 [label="NotificationsRouter\n未读数", fillcolor="#dbeafe", color="#3b82f6"];
    v1 [label="AlertService\n处理闭环 · 统计", fillcolor="#eff6ff", color="#3b82f6"];
    v2 [label="ThresholdRuleEngine\n读 sys_config", fillcolor="#eff6ff", color="#3b82f6"];
    v3 [label="SummaryWorker\n异步摘要 · 可重试", fillcolor="#eff6ff", color="#3b82f6"];
    d1 [label="health_warning 预警", fillcolor="#f8fafc", color="#64748b"];
    d2 [label="alert_receiver 接收人已读", fillcolor="#f8fafc", color="#64748b"];
    d3 [label="warning_handle_record 留痕", fillcolor="#f8fafc", color="#64748b"];
    x1 [label="M3 录入触发（同步）", fillcolor="#fef9c3", color="#ca8a04", style="rounded,dashed"];
    x2 [label="M4 RiskAgent 触发", fillcolor="#fef9c3", color="#ca8a04", style="rounded,dashed"];
    x3 [label="站内通知（D-03）\n无短信 / 电话", fillcolor="#fef9c3", color="#ca8a04", style="rounded,dashed"];
    {rank=same; s1 s2}
    {rank=same; v1 v2 v3}
    {rank=same; d1 d2 d3 x1 x2 x3}
  }
  s1 -> v1 [label="调用", color="#3b82f6", fontcolor="#1d4ed8"];
  s2 -> v1 [label="调用", color="#3b82f6", fontcolor="#1d4ed8"];
  v1 -> v2 [style=dashed, dir=both, arrowtail=none, constraint=false];
  v1 -> v3 [style=dashed, dir=both, arrowtail=none, constraint=false];
  v1 -> d1 [label="读写", color="#64748b", fontcolor="#475569"];
  v1 -> d2 [label="读写", color="#64748b", fontcolor="#475569"];
  v1 -> d3 [label="读写", color="#64748b", fontcolor="#475569"];
  v2 -> x1 [style=dashed, arrowhead=vee, color="#ca8a04", fontcolor="#854d0e", label="依赖 / 触发"];
  v3 -> x2 [style=dashed, arrowhead=vee, color="#ca8a04", fontcolor="#854d0e", constraint=false];
  v1 -> x3 [style=dashed, arrowhead=vee, color="#ca8a04", fontcolor="#854d0e", constraint=false];
}
