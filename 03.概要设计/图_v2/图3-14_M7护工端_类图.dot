digraph G {
  graph [fontname="Microsoft YaHei", bgcolor="white", rankdir=TB,
         nodesep=0.35, ranksep=0.5, dpi=200, pad=0.3, splines=spline, compound=true, size="9,6"];
  node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=15,
         penwidth=1.5, margin="0.20,0.12", fillcolor="#eff6ff", color="#3b82f6"];
  edge  [fontname="Microsoft YaHei", fontsize=12, color="#94a3b8", fontcolor="#475569",
         penwidth=1.1, arrowsize=0.7];
  node [shape=plaintext, fillcolor="white", color="white", style=""];
  subgraph cluster_cls {
    label="M7 护工端　类图（CARE）"; labeljust="l"; fontname="Microsoft YaHei";
    fontsize=16; fontcolor="#0f172a"; style="rounded"; color="#cbd5e1"; penwidth=1.4; margin=14;
    CareRouter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#eff6ff" COLOR="#3b82f6"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>CareRouter</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">接口层：负责老人列表 / 老人详情 / 处理记录</FONT></TD></TR></TABLE>>];
    CareService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#eff6ff" COLOR="#3b82f6"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>CareService</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">应用层：状态聚合排序、详情组装</FONT></TD></TR></TABLE>>];
    CareScopeResolver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#fef3c7" COLOR="#d97706"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>CareScopeResolver</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">按 care_relation 计算护工负责范围</FONT></TD></TR></TABLE>>];
    CareRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f8fafc" COLOR="#64748b"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>CareRepository</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">数据层：care_relation 与跨表聚合查询</FONT></TD></TR></TABLE>>];
    ElderStatusAssembler [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f0fdf4" COLOR="#16a34a"><TR><TD SIDES="B"><FONT POINT-SIZE="15"><U>ElderStatusAssembler</U></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">聚合最近指标与待处理预警，产出 NORMAL / WATCH / ABNORMAL</FONT></TD></TR></TABLE>>];
  }
  CareRouter -> CareService [label="调用", arrowhead=vee, color="#64748b"];
  CareService -> CareScopeResolver [label="取范围", arrowhead=vee, color="#64748b"];
  CareService -> ElderStatusAssembler [label="组装状态", arrowhead=vee, color="#64748b"];
  CareService -> CareRepository [label="查询", arrowhead=vee, color="#64748b"];
}
