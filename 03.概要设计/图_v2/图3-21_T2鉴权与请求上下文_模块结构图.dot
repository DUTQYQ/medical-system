digraph G {
  graph [fontname="Microsoft YaHei", bgcolor="white", rankdir=TB,
         nodesep=0.35, ranksep=0.5, dpi=200, pad=0.3, splines=spline, compound=true, size="9,4.6"];
  node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=15,
         penwidth=1.5, margin="0.20,0.12", fillcolor="#eff6ff", color="#3b82f6"];
  edge  [fontname="Microsoft YaHei", fontsize=12, color="#94a3b8", fontcolor="#475569",
         penwidth=1.1, arrowsize=0.7];
  subgraph cluster_main {
    label="T2 鉴权与请求上下文　模块结构（TECH · AUTH CONTEXT）\n实线箭头＝调用与读写；虚线箭头＝依赖与上游触发"; labeljust="l"; fontname="Microsoft YaHei";
    fontsize=16; fontcolor="#0f172a"; style="rounded"; color="#cbd5e1"; penwidth=1.4; margin=14;
    s1 [label="Depends(get_current_user)\n被除注册 / 登录外的全部接口引用", fillcolor="#dbeafe", color="#3b82f6"];
    s2 [label="require_role(...)\n后台与配置类接口", fillcolor="#dbeafe", color="#3b82f6"];
    v1 [label="JwtProvider\n签发 / 解析 / 失效列表", fillcolor="#eff6ff", color="#3b82f6"];
    v2 [label="PasswordHasher\nbcrypt", fillcolor="#eff6ff", color="#3b82f6"];
    v3 [label="RequestContext\n请求 ID · IP · 用户", fillcolor="#eff6ff", color="#3b82f6"];
    d1 [label="user 表\n读取账号与状态", fillcolor="#f8fafc", color="#64748b"];
    x1 [label=".env\nJWT_SECRET · JWT_TTL", fillcolor="#fef9c3", color="#ca8a04", style="rounded,dashed"];
    x2 [label="被 T4 日志模块引用\n（写入操作人）", fillcolor="#fef9c3", color="#ca8a04", style="rounded,dashed"];
    {rank=same; s1 s2}
    {rank=same; v1 v2 v3}
    {rank=same; d1 x1 x2}
  }
  s1 -> v1 [label="调用", color="#3b82f6", fontcolor="#1d4ed8"];
  s2 -> v1 [label="调用", color="#3b82f6", fontcolor="#1d4ed8"];
  v1 -> v2 [style=dashed, dir=both, arrowtail=none, constraint=false];
  v1 -> v3 [style=dashed, dir=both, arrowtail=none, constraint=false];
  v1 -> d1 [label="读写", color="#64748b", fontcolor="#475569"];
  v2 -> x1 [style=dashed, arrowhead=vee, color="#ca8a04", fontcolor="#854d0e", label="依赖 / 触发"];
  v3 -> x2 [style=dashed, arrowhead=vee, color="#ca8a04", fontcolor="#854d0e", constraint=false];
}
