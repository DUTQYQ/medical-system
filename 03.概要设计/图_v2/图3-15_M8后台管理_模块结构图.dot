digraph G {
  graph [fontname="Microsoft YaHei", bgcolor="white", rankdir=TB,
         nodesep=0.35, ranksep=0.5, dpi=200, pad=0.3, splines=spline, compound=true, size="9,4.6"];
  node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=15,
         penwidth=1.5, margin="0.20,0.12", fillcolor="#eff6ff", color="#3b82f6"];
  edge  [fontname="Microsoft YaHei", fontsize=12, color="#94a3b8", fontcolor="#475569",
         penwidth=1.1, arrowsize=0.7];
  subgraph cluster_main {
    label="M8 后台管理　模块结构（ADMIN）\n实线箭头＝调用与读写；虚线箭头＝依赖与上游触发"; labeljust="l"; fontname="Microsoft YaHei";
    fontsize=16; fontcolor="#0f172a"; style="rounded"; color="#cbd5e1"; penwidth=1.4; margin=14;
    s1 [label="AdminRouter\napp/api/v1/admin.py", fillcolor="#dbeafe", color="#3b82f6"];
    s2 [label="AdminGuard\n仅 ADMIN 可访问", fillcolor="#dbeafe", color="#3b82f6"];
    v1 [label="UserAdminService", fillcolor="#eff6ff", color="#3b82f6"];
    v2 [label="ThresholdConfigService\n写后刷缓存", fillcolor="#eff6ff", color="#3b82f6"];
    v3 [label="KnowledgeService", fillcolor="#eff6ff", color="#3b82f6"];
    v4 [label="StatisticsService", fillcolor="#eff6ff", color="#3b82f6"];
    d1 [label="user 账号", fillcolor="#f8fafc", color="#64748b"];
    d2 [label="sys_config 阈值与参数", fillcolor="#f8fafc", color="#64748b"];
    d3 [label="knowledge_document 知识条目", fillcolor="#f8fafc", color="#64748b"];
    x1 [label="写 sys_config 后\nM5 即时生效（FR-ADMIN-009）", fillcolor="#fef9c3", color="#ca8a04", style="rounded,dashed"];
    {rank=same; s1 s2}
    {rank=same; v1 v2 v3 v4}
    {rank=same; d1 d2 d3 x1}
  }
  s1 -> v1 [label="调用", color="#3b82f6", fontcolor="#1d4ed8"];
  s2 -> v1 [label="调用", color="#3b82f6", fontcolor="#1d4ed8"];
  v1 -> v2 [style=dashed, dir=both, arrowtail=none, constraint=false];
  v1 -> v3 [style=dashed, dir=both, arrowtail=none, constraint=false];
  v1 -> v4 [style=dashed, dir=both, arrowtail=none, constraint=false];
  v1 -> d1 [label="读写", color="#64748b", fontcolor="#475569"];
  v1 -> d2 [label="读写", color="#64748b", fontcolor="#475569"];
  v1 -> d3 [label="读写", color="#64748b", fontcolor="#475569"];
  v2 -> x1 [style=dashed, arrowhead=vee, color="#ca8a04", fontcolor="#854d0e", label="依赖 / 触发"];
}
