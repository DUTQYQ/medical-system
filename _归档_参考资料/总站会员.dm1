     11 -- 其他收入
20 -- 设备消费 -- 日结 -- business.equity
     21 -- 设备消费
30 -- 异业合作 -- 埋单、日结 -- business.goods
     31 -- 项目销售
40 -- 商品 -- 埋单、日结 -- business.gift
     41 -- 商品销售
     42 -- 商品租赁
     43 -- 商品返还
50 -- 门票 -- 埋单、日结 -- business.ticket
     51 -- 门票销售
     52 -- 门票预约改期收费
60 -- OTA -- 埋单、日结 -- ota
     61 -- OTA缴款
70 -- 经销商 -- 埋单、日结 -- dealer
     71 -- 请票单支付
80 -- 官网 -- 埋单、日结 -- official
     81 -- 会员购买
90 -- 优惠券 -- 埋单、日结 -- coupon
     91 -- 推销员还款

A0 -- 酒店 -- 外接系统 -- hotel
     A1 -- 酒店消费
     A2 -- 酒店押金
     A3 -- 酒店押金返还
B0 -- 餐厅 -- 外接系统 -- restaurant
